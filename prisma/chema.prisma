// this is your Prisma chema file,
// learn more about it in the documentations: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-schema-js";
}

datasource db {
    provider = "postgresql";
    url = evn("DATABASE_URL");
}

model User {
    id Int @id @default(autoincrement())
    email String @unique
    password String
    name String?
}